# =============================================================================
# MEDIPATH — Environment Configuration Template
# Never commit real secrets. Keep service-role keys strictly on the backend.
# =============================================================================

# --- Shared / Supabase Public Config (Frontend + Backend) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_URL=http://localhost:5173

# --- Backend-Only Configuration (Render / Node Server) ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Service Role (NEVER prefix with VITE_ or expose in frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Local Dev Persistence Mode ('auto' uses Supabase when configured, else local dev-store)
PERSISTENCE_MODE=auto
DEV_JWT_SECRET=medipath-local-dev-secret-change-in-production

